{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FreeMixer/omx-contract/raw/main/schema/omx-contract.schema.json",
  "title": "omx-contract data file",
  "description": "A map from an export name to one item: a scalar, a travels table or travel, a sheet, a list, a set, codes, words or a format's terms. GPL-3.0-or-later.",
  "x-omx-schema-version": "3.0.0",
  "type": "object",
  "if": { "required": ["origin"] },
  "then": { "$ref": "#/$defs/descriptor" },
  "else": {
    "properties": {
      "$schema": { "type": "string" },
      "requires": { "$ref": "#/$defs/requires" },
      "source": { "$ref": "#/$defs/source" },
      "render": { "$ref": "#/$defs/render" },
      "checks": { "$ref": "#/$defs/checks" }
    },
    "propertyNames": { "anyOf": [{ "enum": ["$schema", "requires", "source", "render", "checks"] }, { "pattern": "^[A-Z][A-Z0-9_]*$" }] },
    "additionalProperties": { "$ref": "#/$defs/item" }
  },
  "$defs": {
    "unit": {
      "description": "The closed list of units the items use; \"s\" is seconds and \"min\" minutes, \"x\" is a multiplier, \"\" is a ratio or a fraction.",
      "enum": ["dB", "dBFS", "ms", "s", "min", "Hz", "oct", "cents", "st", "%", "x", ""]
    },
    "descriptorUnit": {
      "description": "A descriptor's unit: a unit of the items, a unit only plugins use (frames, bpm, midiNote, LUFS, deg, ratio: LV2 units:frame, units:bpm, units:midiNote, units:degree; LUFS and ratio, n:1, have no LV2 unit), or unknown, the plugin states none (docs/descriptors.md).",
      "anyOf": [{ "$ref": "#/$defs/unit" }, { "enum": ["frames", "bpm", "midiNote", "LUFS", "deg", "ratio", "unknown"] }]
    },
    "meaning": {
      "description": "What a control does, the closed list seeded from the panel roles; the LV2 param: or lv2:designation name where LV2 has the term (docs/descriptors.md). unknown: the plugin states none.",
      "enum": [
        "gain", "threshold", "ratio", "attack", "release", "hold", "decay", "frequency", "cutoffFrequency", "resonance", "bypass",
        "wetDryRatio", "delay", "enabled",
        "range", "knee", "hysteresis", "makeup", "lookahead", "ceiling", "output", "q", "slope", "width", "drive", "tone", "rate",
        "depth", "feedback", "spread", "predelay", "size", "damping", "lowCut", "highCut", "shift", "fine", "sync", "division", "listen",
        "unknown"
      ]
    },
    "handle": {
      "description": "A host's handle on a control or a port: a CLAP id (an integer) or an LV2 port symbol.",
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }]
    },
    "descriptor": {
      "type": "object",
      "description": "One plugin described in the contract's words (docs/descriptors.md): its identity, controls, ports, instrument, what it needs from a host and its latency. It declares no item.",
      "properties": {
        "$schema": { "type": "string" },
        "requires": { "$ref": "#/$defs/requires" },
        "origin": { "enum": ["authored", "built", "scanned"], "description": "authored by the owner; built from the owner's built binary; scanned on a user's machine." },
        "plugin": { "$ref": "#/$defs/plugin" },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/descriptorControl" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "instrument": { "$ref": "#/$defs/instrument" },
        "needs": { "$ref": "#/$defs/needs" },
        "latency": { "$ref": "#/$defs/latency" },
        "extensions": { "$ref": "#/$defs/extensions" },
        "source": { "$ref": "#/$defs/source" }
      },
      "required": ["origin", "plugin", "controls", "ports"],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "The extension bag (docs/descriptors.md): per format, the facts of that format no word carries, each under its source field and carried verbatim. A reader never reads a bag value as a word.",
      "propertyNames": { "enum": ["clap", "lv2"] },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/sourceField" },
        "minProperties": 1
      },
      "minProperties": 1
    },
    "sourceField": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*([.:#/][A-Za-z0-9_][A-Za-z0-9_-]*)*$", "description": "A field a scan of a format reads, as the format names it: a CLAP struct field (clap_param_info.min_value) or an LV2 predicate (units:unit)." },
    "plugin": {
      "type": "object",
      "description": "The plugin's identity as it states it: id, the CLAP id or the LV2 URI.",
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "format": { "enum": ["clap", "lv2"] },
        "uri": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "vendor": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" },
        "doc": { "type": "string", "minLength": 1, "pattern": "^[^\\n\\r]*$", "description": "The plugin's one-line description, one word for both faces: CLAP clap_plugin_descriptor.description, LV2 rdfs:comment." },
        "features": {
          "description": "CLAP's feature names; LV2 classes map onto them.",
          "type": "array",
          "items": { "enum": ["audio-effect", "instrument", "note-effect", "analyzer"] },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["id", "format", "name", "features"],
      "additionalProperties": false
    },
    "descriptorTravel": {
      "type": "object",
      "description": "A descriptor control's travel: the kernel travel's words, unit and scale always stated (unknown when the plugin states none).",
      "properties": {
        "min": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" },
        "step": { "$ref": "#/$defs/number" },
        "unit": { "$ref": "#/$defs/descriptorUnit" },
        "default": { "$ref": "#/$defs/number" },
        "defaultFrom": { "enum": ["desk"] },
        "scale": { "type": "string", "pattern": "^[a-z]+$", "description": "An id of PARAM_SCALES, or unknown." },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" }
      },
      "required": ["min", "max", "unit", "scale"],
      "additionalProperties": false
    },
    "descriptorControl": {
      "type": "object",
      "description": "One control of a plugin: the kernel control's words, with the host's id, the symbol a session keys it by, a label, a group, a meaning and the CLAP param flags.",
      "properties": {
        "id": { "$ref": "#/$defs/handle" },
        "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "The stable name a session keys the control by, beside a CLAP clap_id: our authored plugins' parameter-contract symbol. An LV2 control's id is its symbol already." },
        "name": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "doc": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["travel", "choice", "toggle", "trigger"] },
        "travel": { "$ref": "#/$defs/descriptorTravel" },
        "ids": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9]+$" }, "minItems": 1, "uniqueItems": true },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/text" }, "minItems": 1 },
        "values": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
        "default": { "oneOf": [{ "type": "string", "pattern": "^[A-Za-z0-9]+$" }, { "type": "boolean" }] },
        "count": { "$ref": "#/$defs/name" },
        "when": {
          "type": "object",
          "properties": { "control": { "$ref": "#/$defs/text" }, "is": { "type": "string", "pattern": "^[A-Za-z0-9]+$" } },
          "required": ["control", "is"],
          "additionalProperties": false
        },
        "group": { "type": "array", "items": { "$ref": "#/$defs/text" }, "minItems": 1 },
        "meaning": { "$ref": "#/$defs/meaning" },
        "hidden": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "automatable": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      },
      "required": ["id", "name", "kind"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "travel" } } },
          "then": { "required": ["travel"], "properties": { "ids": false, "labels": false, "values": false, "default": false } }
        },
        {
          "if": { "properties": { "kind": { "const": "choice" } } },
          "then": { "required": ["ids"], "properties": { "travel": false, "default": { "type": "string" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "toggle" } } },
          "then": { "properties": { "travel": false, "ids": false, "labels": false, "values": false, "default": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "trigger" } } },
          "then": { "properties": { "travel": false, "ids": false, "labels": false, "values": false, "default": false } }
        }
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "description": "One port of a plugin, in the plugin's order: an audio port's role, channels and layout; a note port's dialects.",
      "properties": {
        "id": { "$ref": "#/$defs/handle" },
        "name": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["audio", "midi", "note", "cv"] },
        "direction": { "enum": ["in", "out"] },
        "role": { "enum": ["main", "sidechain", "aux"] },
        "channels": { "type": "integer", "minimum": 1 },
        "layout": { "enum": ["mono", "stereo", "surround"] },
        "dialects": { "type": "array", "items": { "enum": ["clap", "midi", "midiMpe", "midi2"] }, "minItems": 1, "uniqueItems": true },
        "source": { "$ref": "#/$defs/source" }
      },
      "required": ["id", "name", "kind", "direction"],
      "additionalProperties": false
    },
    "instrument": {
      "type": "object",
      "description": "Present when the plugin's features hold instrument: notes in, audio out. voices only when the plugin states it.",
      "properties": {
        "voices": { "type": "integer", "minimum": 1 },
        "polyphonic": { "type": "boolean" }
      },
      "required": ["polyphonic"],
      "additionalProperties": false
    },
    "needs": {
      "type": "object",
      "description": "What the host must give: the transport, the tempo, the CLAP host extensions or LV2 features asked for.",
      "properties": {
        "transport": { "type": "boolean" },
        "tempo": { "type": "boolean" },
        "extensions": {
          "type": "object",
          "properties": {
            "required": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
            "optional": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "latency": {
      "type": "object",
      "description": "reports: the plugin reports its latency; frames: a constant the plugin or kernel defines, never a measured figure.",
      "properties": {
        "reports": { "type": "boolean" },
        "frames": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/ref" }] }
      },
      "required": ["reports"],
      "additionalProperties": false
    },
    "text": { "type": "string", "minLength": 1 },
    "since": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "The release that first carried an item declared outside the kernels (rates.json, primitives.json); a kernel's items record it in recipes/answers/." },
    "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "floor": { "type": "string", "pattern": "^>= (0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "description": "A version floor, never a ceiling." },
    "requires": {
      "type": "object",
      "description": "What a file needs to be read: omx-contract-schema, the lowest schema its words need; any other key a package whose items it refers to. Each a floor.",
      "properties": { "omx-contract-schema": { "$ref": "#/$defs/floor" } },
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/floor" },
      "minProperties": 1
    },
    "link": {
      "type": "string",
      "description": "<path>#<symbol>[.<field>|[<key>]]...: a path relative to the owner's root, a symbol defined there (enum X and struct X name a tag), and selectors into its value.",
      "pattern": "^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)*#((enum|struct|union) )?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*|\\[[A-Za-z0-9_.-]+\\])*$"
    },
    "linkAt": {
      "type": "object",
      "description": "One link with its own at: <package>@<version> of the tree it lies in, in place of the source's (an impl in the owner's tree beside a from in the console's, at the commit it was imported from).",
      "properties": { "link": { "$ref": "#/$defs/link" }, "at": { "$ref": "#/$defs/at" } },
      "required": ["link", "at"],
      "additionalProperties": false
    },
    "oneLink": { "oneOf": [{ "$ref": "#/$defs/link" }, { "$ref": "#/$defs/linkAt" }] },
    "at": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*@[A-Za-z0-9._+-]+$" },
    "links": { "oneOf": [{ "$ref": "#/$defs/oneLink" }, { "type": "array", "items": { "$ref": "#/$defs/oneLink" }, "minItems": 1, "uniqueItems": true }] },
    "source": {
      "type": "object",
      "description": "Where a definition comes from and where it is implemented (docs/contract-dir.md): from, the provenance, a link compared to the whole value or a map from a field path of the value to a link; impl, the connector; at, <package>@<version> of links outside the owner's tree. A link may carry its own at ({ link, at }), which stands for it in place of the source's.",
      "properties": {
        "from": {
          "oneOf": [
            { "$ref": "#/$defs/oneLink" },
            { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$" }, "additionalProperties": { "$ref": "#/$defs/oneLink" }, "minProperties": 1 }
          ]
        },
        "impl": { "$ref": "#/$defs/links" },
        "at": { "$ref": "#/$defs/at" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "description": "How the owner's own renders of this file are framed (docs/render.md): c, the headers rendered from the file's items (or its package's); ts, the module of the file's items. It declares no item; the tool reads it and names none.",
      "properties": {
        "c": { "type": "array", "items": { "$ref": "#/$defs/renderHeader" }, "minItems": 1 },
        "ts": {
          "type": "object",
          "properties": { "module": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" } },
          "required": ["module"],
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "description": "Relations between numbers several packages state, which no one item can carry (docs/contract-dir.md): validate refuses (rule check) a sum of the numbers `sum` names above the number `atMost` names. A read that lacks an item a check names skips the check. It declares no item.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "doc": { "$ref": "#/$defs/text" },
          "sum": { "type": "array", "items": { "$ref": "#/$defs/checkTerm" }, "minItems": 1 },
          "atMost": { "$ref": "#/$defs/checkTerm" }
        },
        "required": ["name", "doc", "sum", "atMost"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checkTerm": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Za-z][A-Za-z0-9]*)*$", "description": "An item name, or an item and the path to one of its leaves (`EQ_BAND_COUNTS.channel.max`)." },
    "renderLine": { "type": "string", "minLength": 1, "pattern": "^(?!.*\\*/)[^\\n\\r]*$", "description": "One line of prose inside a C comment: no line break, no comment end." },
    "renderGlob": { "type": "string", "pattern": "^\\*?[A-Za-z][A-Za-z0-9]*\\*?$", "description": "A field name, its start (`worker*`), its end (`*Dbfs`) or a part of it (`*Ring*`)." },
    "renderHeader": {
      "type": "object",
      "description": "One C header: its path, include guard, the project its licence block names, the banner under GENERATED, the @file brief, the system headers it includes, which items it reads (scope: the file's, the default, or the package's) and its sections. numbers: every sheet, each field <prefix><FIELD> with a u literal, a level field (levels) a float one, the omitted fields left out, each with its docs line. codes: every codes item, <prefix><NAME> its code string. scalars: every number spelled OMX_<macro> as omx_contract_limits.h spells it, sorted by macro. limits: every section of omx_contract_limits.h, the same defines.",
      "properties": {
        "header": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*\\.h$" },
        "guard": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_H$" },
        "project": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "banner": { "type": "array", "items": { "$ref": "#/$defs/renderLine" }, "minItems": 1 },
        "brief": { "$ref": "#/$defs/renderLine" },
        "includes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_/]*\\.h$" }, "uniqueItems": true },
        "scope": { "enum": ["file", "package"] },
        "numbers": {
          "type": "object",
          "properties": {
            "comment": { "$ref": "#/$defs/renderLine" },
            "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_$" },
            "omit": { "type": "array", "items": { "$ref": "#/$defs/renderGlob" }, "uniqueItems": true },
            "levels": { "$ref": "#/$defs/renderGlob" }
          },
          "required": ["comment", "prefix"],
          "additionalProperties": false
        },
        "codes": {
          "type": "object",
          "properties": { "comment": { "$ref": "#/$defs/renderLine" }, "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_$" } },
          "required": ["comment", "prefix"],
          "additionalProperties": false
        },
        "scalars": {
          "type": "object",
          "properties": { "comment": { "$ref": "#/$defs/renderLine" } },
          "required": ["comment"],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": { "comment": { "$ref": "#/$defs/renderLine" } },
          "additionalProperties": false
        }
      },
      "required": ["header", "guard", "project", "banner", "brief"],
      "anyOf": [{ "required": ["numbers"] }, { "required": ["codes"] }, { "required": ["scalars"] }, { "required": ["limits"] }],
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "properties": { "ref": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Za-z][A-Za-z0-9]*)*$" } },
      "required": ["ref"],
      "additionalProperties": false
    },
    "derive": {
      "description": "The closed list of derivations; a new one is a renderer change with its own test.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "derive": { "const": "count" }, "of": { "$ref": "#/$defs/name" } },
          "required": ["derive", "of"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "derive": { "const": "sqrt" }, "of": { "$ref": "#/$defs/number" } },
          "required": ["derive", "of"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "derive": { "const": "ceilSum" },
            "of": { "type": "array", "items": { "$ref": "#/$defs/number" }, "minItems": 2 }
          },
          "required": ["derive", "of"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "derive": { "const": "lagrangeReadL1" },
            "order": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/ref" }] }
          },
          "required": ["derive", "order"],
          "additionalProperties": false
        }
      ]
    },
    "number": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/ref" }, { "$ref": "#/$defs/derive" }] },
    "travel": {
      "type": "object",
      "properties": {
        "min": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" },
        "step": { "$ref": "#/$defs/number" },
        "unit": { "$ref": "#/$defs/unit" },
        "default": { "$ref": "#/$defs/number" },
        "defaultFrom": { "enum": ["desk"] },
        "scale": { "type": "string", "pattern": "^[a-z]+$", "description": "How a host draws the travel: an id of PARAM_SCALES." },
        "byKind": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/number" },
          "minProperties": 1
        },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "readout": {
      "type": "object",
      "description": "A value a kernel reports while it runs and a host draws: a meter. Declared in a kernel file's `readouts`, in order; its position is its id (docs/readouts.md).",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "doc": { "$ref": "#/$defs/text" },
        "unit": { "$ref": "#/$defs/unit" },
        "min": { "$ref": "#/$defs/number" },
        "max": { "$ref": "#/$defs/number" },
        "scale": { "type": "string", "pattern": "^[a-z]+$", "description": "How a host draws the readout: an id of PARAM_SCALES." },
        "rateHz": { "$ref": "#/$defs/number" }
      },
      "required": ["name", "doc", "unit", "min", "max", "scale", "rateHz"],
      "additionalProperties": false
    },
    "sheetValue": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/number" }, { "$ref": "#/$defs/sheetValue" }] },
      "minProperties": 1
    },
    "scalar": {
      "type": "object",
      "properties": {
        "kind": { "const": "scalar" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "unit": { "$ref": "#/$defs/unit" },
        "value": { "oneOf": [{ "$ref": "#/$defs/number" }, { "type": "boolean" }] }
      },
      "required": ["kind", "doc", "unit", "value"],
      "additionalProperties": false
    },
    "travels": {
      "type": "object",
      "properties": {
        "kind": { "const": "travels" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "fields": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "oneOf": [{ "$ref": "#/$defs/travel" }, { "$ref": "#/$defs/ref" }] },
          "minProperties": 1
        },
        "travel": { "$ref": "#/$defs/travel" }
      },
      "required": ["kind", "doc"],
      "oneOf": [{ "required": ["fields"] }, { "required": ["travel"] }],
      "additionalProperties": false
    },
    "sheet": {
      "type": "object",
      "properties": {
        "kind": { "const": "sheet" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/sheetValue" },
        "docs": {
          "description": "One line of prose per top-level field of `value`, rendered beside the field's define in a header that documents it. A field without one has none.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/text" },
          "minProperties": 1
        }
      },
      "required": ["kind", "doc", "value"],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "kind": { "const": "list" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "unit": { "$ref": "#/$defs/unit" },
        "values": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
        "c": {
          "type": "object",
          "properties": { "render": { "type": "boolean" } },
          "additionalProperties": false
        }
      },
      "required": ["kind", "doc", "unit", "values"],
      "additionalProperties": false
    },
    "codes": {
      "type": "object",
      "description": "Refusal and verdict codes: a lowerCamel name per code, the operator-facing key a consumer reads it by, the code itself (`hosting.<dimension>.<reason>`, a realisation outcome `hosting.<reason>`, or `contract.<group>.<reason>` for the reader's own, lower case, read by verdicts and never reworded; the console renders the locale from the code) and optionally one line of prose.",
      "properties": {
        "kind": { "const": "codes" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "codes": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "pattern": "^(hosting(\\.[a-z0-9]+(-[a-z0-9]+)*){1,}|contract(\\.[a-z0-9]+(-[a-z0-9]+)*){2,})$" },
              "doc": { "$ref": "#/$defs/text" }
            },
            "required": ["code"],
            "additionalProperties": false
          },
          "minProperties": 1
        }
      },
      "required": ["kind", "doc", "codes"],
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "description": "Ordered ids with an optional default, labels and a value per id. The ids and their order are the contract: all strings of letters and digits (the id is the name, its position the value; an id may start with a digit, as 4x does) or all non-negative integers (the id is the value). Labels are face text and optional. The default may be a reference to the scalar that states it: a boolean names the second id of a two-id switch when true, the first when false.",
      "properties": {
        "kind": { "const": "set" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "ids": {
          "oneOf": [
            { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9]+$" }, "minItems": 1, "uniqueItems": true },
            { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "default": { "oneOf": [{ "type": "string", "pattern": "^[A-Za-z0-9]+$" }, { "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/ref" }] },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/text" }, "minItems": 1 },
        "unit": { "$ref": "#/$defs/unit" },
        "values": {
          "description": "The value each id carries, in `unit`, one per id in id order; null for an id that carries none (the drive's `off` roll-off has no corner). Only a set of named ids carries values: a numeric id is its own value.",
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/number" }, { "type": "null" }] },
          "minItems": 1
        }
      },
      "required": ["kind", "doc", "ids"],
      "dependentRequired": { "values": ["unit"], "unit": ["values"] },
      "additionalProperties": false
    },
    "word": { "type": "string", "pattern": "^[A-Za-z0-9<][A-Za-z0-9._+<-]*$", "description": "A word of a vocabulary as it is written on the wire: letters, digits, '-', '_', '.', '+' and a leading '<' (a band such as <1.5GHz)." },
    "termRef": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*#[A-Za-z0-9][A-Za-z0-9._/+-]*$", "description": "<TERMS item>#<term>: one term of a format's vocabulary (data/formats/), the format word a word of ours borrows its name from." },
    "words": {
      "type": "object",
      "description": "A closed vocabulary the qualification and its hosts speak (docs/data-layout.md): a lowerCamel name per word, the word as written, optionally the group it falls in (a word of the item `groups` names), the format terms it is name-compatible with and one line of prose. The words and their order are the contract; a word is never reworded.",
      "properties": {
        "kind": { "const": "words" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "groups": { "$ref": "#/$defs/name" },
        "words": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "word": { "$ref": "#/$defs/word" },
              "group": { "$ref": "#/$defs/word" },
              "from": { "type": "array", "items": { "$ref": "#/$defs/termRef" }, "minItems": 1, "uniqueItems": true },
              "doc": { "$ref": "#/$defs/text" }
            },
            "required": ["word"],
            "additionalProperties": false
          },
          "minProperties": 1
        }
      },
      "required": ["kind", "doc", "words"],
      "additionalProperties": false
    },
    "termCite": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9_+.@/-]+(#[A-Za-z0-9_$/.-]+)?$", "description": "<repository>:<path>[#<anchor>]: the file of a consumer that reads or writes the term." },
    "term": {
      "type": "object",
      "description": "One term of a format, mapped (docs/data-layout.md): its LV2 URI or CLAP identifier (with the string it stands for), what it is, and its status for us. used names the consumers that read or write it; supported-later the issue that brings it; out-of-scope the ruling that keeps it out (a consumer may still read it, to refuse it). word: the contract's own word it maps onto, where the descriptor has one.",
      "properties": {
        "uri": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "id": { "type": "string", "pattern": "^CLAP_[A-Z0-9_]+$" },
        "value": { "type": "string" },
        "kind": {
          "enum": [
            "specification", "class", "plugin-class", "property", "datatype", "port-property", "feature", "extension-data", "option",
            "parameter", "channel", "port-protocol", "unit", "individual",
            "extension", "factory", "plugin-feature", "port-type", "window-api", "event-type", "note-dialect", "process-status",
            "log-severity", "flag", "enum-value", "constant"
          ]
        },
        "status": { "enum": ["used", "supported-later", "out-of-scope"] },
        "by": { "type": "array", "items": { "$ref": "#/$defs/termCite" }, "minItems": 1, "uniqueItems": true },
        "issue": { "type": "string", "pattern": "^FreeMixer/[a-z0-9-]+#[1-9][0-9]*$" },
        "ruling": { "$ref": "#/$defs/text" },
        "word": { "$ref": "#/$defs/text" },
        "deprecated": { "const": true }
      },
      "required": ["kind", "status"],
      "oneOf": [{ "required": ["uri"] }, { "required": ["id"] }],
      "allOf": [
        { "if": { "properties": { "status": { "const": "used" } } }, "then": { "required": ["by"], "properties": { "issue": false, "ruling": false } } },
        { "if": { "properties": { "status": { "const": "supported-later" } } }, "then": { "required": ["issue"], "properties": { "ruling": false } } },
        { "if": { "properties": { "status": { "const": "out-of-scope" } } }, "then": { "required": ["ruling"], "properties": { "issue": false } } }
      ],
      "additionalProperties": false
    },
    "terms": {
      "type": "object",
      "description": "A format's vocabulary as one specification or header states it, every term mapped (docs/data-layout.md): the format, the specification (an LV2 specification's URI, a CLAP header's path), its version, and each term under our name, name-compatible with it: an LV2 term's local name, a CLAP string constant's text less `clap.`, any other CLAP identifier in lowerCamel less `CLAP_`.",
      "properties": {
        "kind": { "const": "terms" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "format": { "enum": ["lv2", "clap"] },
        "spec": { "$ref": "#/$defs/text" },
        "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
        "deprecated": { "const": true },
        "terms": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+-]*$" },
          "additionalProperties": { "$ref": "#/$defs/term" },
          "minProperties": 1
        }
      },
      "required": ["kind", "doc", "format", "spec", "version", "terms"],
      "additionalProperties": false
    },
    "formatMapRow": {
      "type": "object",
      "description": "One source field of a format map: exactly one class (word, extension or dropped) and what it covers (a term, or a from link).",
      "properties": {
        "term": { "$ref": "#/$defs/termRef" },
        "from": { "oneOf": [{ "$ref": "#/$defs/link" }, { "type": "string", "pattern": "^https?://[^\\s]+$" }] },
        "word": {
          "type": "object",
          "description": "The descriptor word the field becomes, the name of the transform that converts it and that transform's data: values, a map read both ways, or factor. Never code.",
          "properties": {
            "word": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\[\\])?(\\.[a-z][A-Za-z0-9]*(\\[\\])?)*$" },
            "transform": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
            "values": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] }, "minProperties": 1 },
            "factor": { "type": "number" }
          },
          "required": ["word", "transform"],
          "not": { "required": ["values", "factor"] },
          "additionalProperties": false
        },
        "extension": { "const": true },
        "dropped": {
          "type": "object",
          "properties": { "ruling": { "$ref": "#/$defs/text" } },
          "required": ["ruling"],
          "additionalProperties": false
        },
        "doc": { "$ref": "#/$defs/text" }
      },
      "oneOf": [{ "required": ["word"] }, { "required": ["extension"] }, { "required": ["dropped"] }],
      "allOf": [{ "oneOf": [{ "required": ["term"] }, { "required": ["from"] }] }],
      "additionalProperties": false
    },
    "formatMap": {
      "type": "object",
      "description": "One format's mapping table (docs/descriptors.md): every field a scan of the format reads, keyed by its source field, mapped to a descriptor word, carried in the extension bag or dropped by a named ruling.",
      "properties": {
        "kind": { "const": "formatMap" },
        "since": { "$ref": "#/$defs/since" },
        "source": { "$ref": "#/$defs/source" },
        "doc": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "format": { "enum": ["lv2", "clap"] },
        "rows": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/sourceField" },
          "additionalProperties": { "$ref": "#/$defs/formatMapRow" },
          "minProperties": 1
        }
      },
      "required": ["kind", "doc", "format", "rows"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["scalar", "travels", "sheet", "list", "set", "codes", "words", "terms", "formatMap"] } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "scalar" } } }, "then": { "$ref": "#/$defs/scalar" } },
        { "if": { "properties": { "kind": { "const": "travels" } } }, "then": { "$ref": "#/$defs/travels" } },
        { "if": { "properties": { "kind": { "const": "sheet" } } }, "then": { "$ref": "#/$defs/sheet" } },
        { "if": { "properties": { "kind": { "const": "list" } } }, "then": { "$ref": "#/$defs/list" } },
        { "if": { "properties": { "kind": { "const": "set" } } }, "then": { "$ref": "#/$defs/set" } },
        { "if": { "properties": { "kind": { "const": "codes" } } }, "then": { "$ref": "#/$defs/codes" } },
        { "if": { "properties": { "kind": { "const": "words" } } }, "then": { "$ref": "#/$defs/words" } },
        { "if": { "properties": { "kind": { "const": "terms" } } }, "then": { "$ref": "#/$defs/terms" } },
        { "if": { "properties": { "kind": { "const": "formatMap" } } }, "then": { "$ref": "#/$defs/formatMap" } }
      ]
    }
  }
}
