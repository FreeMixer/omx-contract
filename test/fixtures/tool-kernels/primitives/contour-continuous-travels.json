{
  "$schema": "../../schema/omx-contract.schema.json",
  "CONTOUR_CONTINUOUS_TRAVELS": {
    "kind": "travels",
    "doc": "The contour continuous travels: an invented travels item with fields of its own.",
    "fields": {
      "freqHz": {
        "min": 30,
        "max": 16000,
        "step": 0,
        "unit": "Hz",
        "default": 1000,
        "defaultFrom": "desk",
        "scale": "log"
      },
      "gainDb": {
        "min": -12,
        "max": 12,
        "step": 0.1,
        "unit": "dB",
        "default": 0,
        "defaultFrom": "desk"
      }
    }
  }
}
