{
  "$schema": "../../schema/omx-contract.schema.json",
  "controls": [
    {
      "name": "rateHz",
      "kind": "travel",
      "global": "WAVE_RATE_RANGE",
      "doc": "The wave rate: an invented travel.",
      "travel": {
        "min": 0.1,
        "max": 12,
        "step": 0.01,
        "unit": "Hz",
        "default": 3,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "depth",
      "kind": "travel",
      "doc": "The wave depth: an invented travel.",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0.1,
        "unit": "%",
        "default": 40,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "mode",
      "kind": "choice",
      "doc": "The wave modes: an invented set.",
      "ids": [
        "level",
        "pan"
      ],
      "default": "level"
    }
  ],
  "aggregates": {
    "WAVE_TRAVELS": {
      "doc": "The wave travels: an invented aggregate.",
      "fields": [
        "rateHz",
        "depth"
      ]
    }
  },
  "constants": {
    "WAVE_BASE_MS": {
      "kind": "scalar",
      "doc": "The wave base delay: an invented scalar.",
      "unit": "ms",
      "value": 6.5
    },
    "WAVE_SWING_MS": {
      "kind": "scalar",
      "doc": "The wave swing: an invented scalar.",
      "unit": "ms",
      "value": 3
    },
    "WAVE_MAX_MS": {
      "kind": "scalar",
      "doc": "The wave delay ceiling: an invented ceilSum.",
      "unit": "ms",
      "value": {
        "derive": "ceilSum",
        "of": [
          {
            "ref": "WAVE_BASE_MS"
          },
          {
            "ref": "WAVE_SWING_MS"
          }
        ]
      }
    },
    "WAVE_PLANT_BANDS": {
      "kind": "scalar",
      "doc": "The bands the wave may plant: an invented count a declared check sums.",
      "unit": "",
      "value": 3
    }
  }
}
