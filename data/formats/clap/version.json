      },
      "versionMinor": {
        "id": "CLAP_VERSION_MINOR",
        "kind": "constant",
        "status": "supported-later",
        "issue": "FreeMixer/omx-clap-core#196"
      },
      "versionRevision": {
        "id": "CLAP_VERSION_REVISION",
        "kind": "constant",
