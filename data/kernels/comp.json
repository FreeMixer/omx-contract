{
  "$schema": "../../schema/omx-contract.schema.json",
  "controls": [
    {
      "name": "thresholdDb",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": -60,
        "max": 0,
        "step": 1,
        "unit": "dB",
        "default": -18,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "ratio",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": 1,
        "max": 20,
        "step": 0.5,
        "unit": "",
        "default": 4,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "kneeDb",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0.5,
        "unit": "dB",
        "default": 6,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "attackMs",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": 0.1,
        "max": 100,
        "step": 1,
        "unit": "ms",
        "default": 5,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "releaseMs",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": 5,
        "max": 3000,
        "step": 10,
        "unit": "ms",
        "default": 200,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "makeupDb",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": 0,
        "max": 24,
        "step": 0.5,
        "unit": "dB",
        "default": 0,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "mixPct",
      "kind": "travel",
      "table": "COMP_LIMITS",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 100,
        "defaultFrom": "desk"
      }
    }
  ],
  "tables": {
    "COMP_LIMITS": {
      "doc": "The legal range of each compressor field (engineering units). The widget clamps drags to these, `normalizeComp` enforces them, the row's codec refuses by them and the travel sheet publishes them. `default`/`defaultFrom` are the come-up values `defaultCompState` seeds a fresh strip with, read BACK from here rather than restated there."
    }
  },
  "constants": {
    "PROGRAM_RELEASE": {
      "kind": "sheet",
      "doc": "The program-dependent release's model constants — the LA-2A's opto cell as DATA (`docs/design/specs/2026-09-26-compressor-models.md` §3b). `chargeMs`/`dischargeMs` are the word's memory constants, shared by every profile; each profile's `fastMs`, `slowMinMs`, `slowMaxMs` and `share` fit the unit's published two-stage recovery. Not operator controls: generated into `omx_contract_limits.h` as `OMX_PROGRAM_RELEASE_*`, which libomxdsp's `omx_env_program_release` reads.",
      "value": {
        "chargeMs": 1000,
        "dischargeMs": 5000,
        "profiles": {
          "opto": {
            "fastMs": 70,
            "slowMinMs": 110,
            "slowMaxMs": 1100,
            "share": 0.5
          }
        }
      }
    }
  }
}
